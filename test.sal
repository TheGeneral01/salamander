class Sample:
    int value = 4

def dyn choose_value(bool use_integer, dyn source):
    int adjustment = 3
    dyn prepared = source
    prepared = prepared + adjustment

    if use_integer:
        int scaled_integer = adjustment * 2
        return prepared + scaled_integer
    else:
        float scaled_float = adjustment / 2.0
        return prepared + scaled_float

def dyn normalize(dyn input_value):
    int offset = 1
    dyn intermediate = input_value
    intermediate = intermediate + offset
    return intermediate

Sample first = Sample()
Sample second = Sample()
bool equal_samples = first == second

